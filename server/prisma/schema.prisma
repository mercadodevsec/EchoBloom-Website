generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String
  organization String?
  roleInterest String?
  message      String
  createdAt    DateTime @default(now())
}

model InternApplication {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  university     String?
  major          String?
  graduationYear String?
  portfolioUrl   String?
  linkedinUrl    String?
  coverLetter    String?
  resumeUrl      String
  resumeFileName String
  createdAt      DateTime @default(now())
}
