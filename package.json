{
  "name": "echobloom-website",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "test": "npm run test --workspace client",
    "test:e2e": "npm run test:e2e --workspace client",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "docker compose up -d --wait && npm run db:push --workspace server && npm run db:generate --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
